{
  "name": "interview-box-pwa",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "typecheck": "tsc -b",
    "check": "node scripts/check.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract": "node scripts/extract-v7.mjs",
    "icons": "node scripts/icons.mjs",
    "e2e": "node e2e/smoke.mjs",
    "e2e:offline": "node e2e/offline.mjs",
    "e2e:mobile": "node e2e/mobile.mjs",
    "e2e:filters": "node e2e/filters.mjs",
    "e2e:audio": "node e2e/audio.mjs",
    "e2e:all": "node e2e/smoke.mjs && node e2e/filters.mjs && node e2e/audio.mjs && node e2e/mobile.mjs && node e2e/offline.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "sql.js": "^1.13.0",
    "ts-fsrs": "^5.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}