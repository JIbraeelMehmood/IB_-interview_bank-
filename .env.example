# ── MongoDB ──────────────────────────────────────────────────────────────────
# Atlas connection string from the Interview Box Atlas project.
# Never commit the real value.
MONGODB_URI=
MONGODB_DATABASE=interview_box

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Required for "Sign in with Google".
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (type: Web application)
# 3. Add Authorised redirect URI:  https://yourapp.vercel.app/api/auth/google-callback
#    (and http://localhost:5173/api/auth/google-callback for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App origin ────────────────────────────────────────────────────────────────
# The canonical public URL of the deployed app (no trailing slash).
# Used to build the Google OAuth redirect_uri.
# In local dev this defaults to http://localhost:5173 so you can leave it blank.
APP_URL=https://yourapp.vercel.app

# ── TTS Server (local Python server, optional) ────────────────────────────────
# URL of the local Python TTS server (server/tts_server.py, default port 5052).
# Leave blank to use browser speechSynthesis only.
# Example: http://localhost:5052
# TTS_PORT=5052

# ── Whisper STT (optional standalone server) ──────────────────────────────────
# URL of a standalone whisper.cpp or faster-whisper HTTP server.
# When set, the microphone transcription button uses this instead of the
# browser's Web Speech API.
# Example: VITE_WHISPER_URL=http://localhost:8080
# Note: VITE_ prefix means this is baked into the frontend bundle at build time.
# VITE_WHISPER_URL=
