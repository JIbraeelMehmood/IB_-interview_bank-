var STOP=/^(the|a|an|and|or|of|to|in|on|for|is|are|what|how|why|when|me|my|i|you|it|do|does|with|about|give|show|find|some|questions?|explain|between|vs|versus|difference|which|can|should|please|tell|this|that|from|be|kya|hai|ka|ki|ke|aur|mein|mujhe)$/;
function qTerms(t){return String(t||'').toLowerCase().replace(/[^a-z0-9#+.\s-]/g,' ').split(/\s+/).filter(function(w){return w.length>1&&!STOP.test(w)})}
function rankQs(text,o){o=o||{};var terms=qTerms(text),tk=o.tech?matchTechIds(String(o.tech)):matchTechIds(text);
  var lv=o.level?({basic:'j',junior:'j',j:'j',mid:'m',m:'m',senior:'s',s:'s'})[String(o.level).toLowerCase()]:null;
  var out=[];QS.forEach(function(q){if(lv&&q.l!==lv)return;if(o.status==='weak'&&S.rate[q.id]!==1)return;if(o.status==='new'&&S.done[q.id])return;
    var sc=0;terms.forEach(function(w){if(q.sq.indexOf(w)>=0)sc+=3;else if(q.sa.indexOf(w)>=0)sc+=1});
    tk.forEach(function(t){if(q.t.indexOf(t)>=0)sc+=2});if(!sc)return;sc+=relScore(q)*0.25;out.push([sc,q])});
  out.sort(function(a,b){return b[0]-a[0]});return out.slice(0,Math.min(+o.limit||10,25)).map(function(x){return x[1]})}
function qStatus(id){return S.rate[id]===1?'weak':S.rate[id]===2?'okay':S.rate[id]===3?'solid':S.done[id]?'practised':'new'}
