function labShowErr(e,sql){
  var m=String(e&&e.message||e);var tip='';
  if(/no such column/i.test(m))tip='Check the column name in the Tables list below. An alias from SELECT can\'t be used in WHERE (WHERE runs before SELECT).';
  else if(/no such table/i.test(m))tip='Check the table name — open "Tables & sample data".';
  else if(/no such function/i.test(m))tip='This runs SQLite: use strftime() instead of DATE_FORMAT(), || for concatenation, and date(x, \'-7 days\') for date maths.';
  else if(/misuse of aggregate/i.test(m))tip='Aggregates like COUNT/SUM can\'t go in WHERE — use HAVING, or a subquery.';
  else if(/syntax error/i.test(m))tip='Look just before the word shown — a missing comma, bracket or quote is common. Strings use single quotes: \'Sales\'.';
  else if(/TRUNCATE/i.test(sql))tip='SQLite has no TRUNCATE — use DELETE FROM table_name;';
  $('#labOut').innerHTML='<div class="labmsg bad">Error: '+esc(m)+'</div>'+(tip?'<p class="small">💡 '+esc(tip)+'</p>':'')+(AIOK?'<div class="row"><button type="button" class="btn sm" data-labai="hint">AI: explain this error</button></div>':'')+'<div id="labAi"></div>';
}
