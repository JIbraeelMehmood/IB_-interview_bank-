var DAY=86400000;
function dayEnd(){var d=new Date();d.setHours(23,59,59,999);return d.getTime()}
function srsSt(){if(!S.srs||typeof S.srs!=='object')S.srs={};return S.srs}
function srsRate(id,v){var s=srsSt();if(!v){delete s[id];return}var o=s[id]||{iv:0,n:0};
  var iv=v===1?1:v===2?Math.max(3,Math.ceil((o.iv||1)*1.6)):Math.max(7,Math.ceil((o.iv||3)*2.5));iv=Math.min(iv,120);
  s[id]={iv:iv,n:(o.n||0)+1,due:Date.now()+iv*DAY,last:v}}
function srsDue(id){var o=srsSt()[id];return !!(o&&o.due<=dayEnd())}
function srsDueList(){return QS.filter(function(q){return srsDue(q.id)}).sort(function(a,b){return srsSt()[a.id].due-srsSt()[b.id].due})}
