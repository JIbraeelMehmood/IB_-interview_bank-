/* ---------- light, safe markdown for AI / user text ---------- */
function md(src){
  var s=String(src||'').replace(/\r/g,'');
  var parts=s.split(/```/), out='';
  for(var i=0;i<parts.length;i++){
    if(i%2===1){var body=parts[i].replace(/^[a-zA-Z0-9_-]*\n/,'');out+='<pre><code>'+esc(body.replace(/\n$/,''))+'</code></pre>';continue}
    var lines=parts[i].split('\n'),inList=null,para=[];
    var flushP=function(){if(para.length){out+='<p>'+inl(para.join(' '))+'</p>';para=[]}};
    var flushL=function(){if(inList){out+='</'+inList+'>';inList=null}};
    lines.forEach(function(ln){
      var t=ln.trim(),m;
      if(!t){flushP();flushL();return}
      if((m=t.match(/^#{1,4}\s+(.*)/))){flushP();flushL();out+='<h4>'+inl(m[1])+'</h4>';return}
      if((m=t.match(/^[-*•]\s+(.*)/))){flushP();if(inList!=='ul'){flushL();out+='<ul>';inList='ul'}out+='<li>'+inl(m[1])+'</li>';return}
      if((m=t.match(/^\d+[.)]\s+(.*)/))){flushP();if(inList!=='ol'){flushL();out+='<ol>';inList='ol'}out+='<li>'+inl(m[1])+'</li>';return}
      flushL();para.push(t)
    });
    flushP();flushL();
  }
  return out;
}
