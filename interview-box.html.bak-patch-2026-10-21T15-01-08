function nv(x){if(x===null||x===undefined)return 'NULL';if(typeof x==='number')return String(Math.round(x*100)/100);var n=Number(x);if(x!==''&&!isNaN(n)&&/^-?\d+(\.\d+)?$/.test(String(x).trim()))return String(Math.round(n*100)/100);return String(x).trim()}
function projectCols(user,exp){
  if(user.columns.length===exp.columns.length)return user;
  var idx=exp.columns.map(function(c){var lc=c.toLowerCase(),i=user.columns.map(function(u){return u.toLowerCase()}).indexOf(lc);return i});
  if(idx.every(function(i){return i>=0}))return {columns:exp.columns,values:user.values.map(function(r){return idx.map(function(i){return r[i]})})};
  // try matching columns by their values
  var used={},map=exp.columns.map(function(c,ci){var col=exp.values.map(function(r){return nv(r[ci])}).sort().join('|');
    for(var j=0;j<user.columns.length;j++){if(used[j])continue;var uc=user.values.map(function(r){return nv(r[j])}).sort().join('|');if(uc===col){used[j]=1;return j}}return -1});
  if(map.every(function(i){return i>=0}))return {columns:exp.columns,values:user.values.map(function(r){return map.map(function(i){return r[i]})})};
  return null;
}
function labCompare(user,exp,ex){
  var u=projectCols(user,exp);
  if(!u)return {ok:false,msg:'Expected '+exp.columns.length+' column'+(exp.columns.length>1?'s':'')+' ('+exp.columns.join(', ')+'), you returned '+user.columns.length+(user.columns.length?' ('+user.columns.join(', ')+')':'')+'.'};
  if(u.values.length!==exp.values.length)return {ok:false,msg:'Expected '+exp.values.length+' row'+(exp.values.length===1?'':'s')+', you returned '+u.values.length+'.'};
  var a=u.values.map(function(r){return r.map(nv).join('¦')}).sort(),b=exp.values.map(function(r){return r.map(nv).join('¦')}).sort();
  for(var i=0;i<a.length;i++)if(a[i]!==b[i])return {ok:false,msg:'Right shape, but some values differ. Compare your rows with the question again.'};
  if(ex.ord){var ci=user.columns.map(function(c){return c.toLowerCase()}).indexOf(ex.ord[0]);
    if(ci>=0){for(var k=1;k<user.values.length;k++){var p=+user.values[k-1][ci],c=+user.values[k][ci];if(ex.ord[1]==='desc'?c>p:c<p)return {ok:false,msg:'Right rows, wrong order — sort by '+ex.ord[0]+' '+ex.ord[1].toUpperCase()+'.'}}}}
  return {ok:true};
}
