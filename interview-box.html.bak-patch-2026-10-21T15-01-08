      (r.tip?'<p class="small"'+urAttr(r.tip)+'><b>Delivery tip:</b> '+inl(r.tip)+'</p>':'')+
      '<div class="row" style="margin-top:8px"><button type="button" class="btn sm lis" id="mListen">🎧 Listen to feedback</button></div>'+
      '<details style="margin-top:8px"><summary class="small"><b>Model answer from the bank</b></summary><div class="ans" style="padding:0;border:0">'+q.a+'</div></details>'+
      '<div class="row" style="margin-top:14px">'+(r.follow_up?'<button type="button" class="btn" id="mFollow">Answer the cross-question</button>':'')+'<button type="button" class="btn primary" id="mNext">'+(M.i+1<M.qs.length?'Next question':'See results')+'</button></div>';
    btn.remove();
    $('#mListen').onclick=function(){var t=(r.verdict||'')+'\n'+(r.missing&&r.missing.length?(S.lang==='en'?'What was missing: ':'')+r.missing.join('. ')+'\n':'')+(r.tip||'');var items=[{isText:true,text:t,title:'Feedback'}];if(r.better)items.push({isText:true,text:'A stronger answer. '+r.better,title:'A stronger answer',k:'en'});startPlayer(items,0,'Feedback')};
    $('#mNext').onclick=function(){M.i++;renderStep()};
    var fu=$('#mFollow');if(fu)fu.onclick=function(){
      var fq={id:'FU-'+uid(),q:String(r.follow_up),a:'<p class="muted">Cross-question generated by the interviewer bot. The AI grades it against best practice.</p>',plain:'(No reference answer — grade on technical correctness and depth for the level.) Original question context: '+q.q,l:q.l,t:q.t,f:'',s:'fu'};
      M.qs.splice(M.i+1,0,fq);M.i++;renderStep()};
  }).catch(function(e){$('#mFb').innerHTML='<p><b>'+esc(aiErr(e))+'</b></p>';btn.disabled=false});
}
