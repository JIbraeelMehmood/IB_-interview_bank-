  var ok=new Array(n).fill(false);i=0;j=0;while(i<n&&j<m){if(a[i]===b[j]){ok[i]=true;i++;j++}else if(dp[i+1][j]>=dp[i][j+1])i++;else j++}
  var hit=ok.filter(Boolean).length;return {words:a,ok:ok,score:n?Math.round(hit/n*100):0}}
function spBest(target,res,accept){
  var cands=[res.text];if(res.alts&&res.alts.length===1)cands=cands.concat(res.alts[0]);
  if(accept){var hw=spWords(res.text).join(' ');var al=[].concat.apply([],res.alts||[]).map(function(x){return spWords(x).join(' ')});
    if(accept.some(function(a){a=spWords(a).join(' ');return hw.indexOf(a)>=0||al.some(function(x){return x.indexOf(a)>=0})}))return {words:spWords(target),ok:spWords(target).map(function(){return true}),score:100}}
  var best=null;cands.forEach(function(c){var r=spAlign(target,c);if(!best||r.score>best.score)best=r});return best}
function spMarkup(r){return r.words.map(function(w,i){return '<span class="spw '+(r.ok[i]?'ok':'miss')+'">'+esc(w)+'</span>'}).join(' ')}
