    if(fl.due&&!srsDue(q.id))return false;
    if(opt.lvl&&q.l!==opt.lvl)return false;
    if(tk.length&&!tk.some(function(t){return q.t.indexOf(t)>=0}))return false;
    if(fl.c&&q.f.indexOf('c')<0)return false;
    if(fl.i&&q.f.indexOf('i')<0)return false;
    if(fl.h&&q.f.indexOf('h')<0)return false;
