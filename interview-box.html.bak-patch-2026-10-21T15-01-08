function kwRegex(kw){
  var parts=kw.filter(Boolean).map(function(k){
    k=String(k).toLowerCase().trim(); var pre=/\*$/.test(k); k=k.replace(/\*$/,'');
    var e=k.replace(/[.*+?^${}()|[\]\\\/]/g,'\\$&').replace(/\s+/g,'\\s+');
    return '(?<![a-z0-9])'+e+(pre?'':'(?![a-z0-9])');
  });
  if(!parts.length) return null;
  try{return new RegExp(parts.join('|'),'gi')}catch(e){return null}
}

