var lastJd=null;
var NICE_RE=/nice to have|nice-to-have|good to have|plus\b|a plus|bonus|preferred|familiarity|exposure to|would be great|advantage/i;
function analyseJd(text){
  var lines=text.split(/\n|(?<=[.;])\s+(?=[A-Z])/).map(function(s){return s.trim()}).filter(Boolean);
  var w={},hits={};
  var niceMode=false;
  lines.forEach(function(ln){
    if(/^(nice|good) to have|^preferred|^bonus|^plus/i.test(ln))niceMode=true;
    else if(/^(requirements|must have|what you|responsibilit|required|qualifications|you have|skills)/i.test(ln))niceMode=false;
    var nice=niceMode||NICE_RE.test(ln);
    TECHS.forEach(function(t){
      if(!t.re||t.id==='deep')return; t.re.lastIndex=0;
      var m=ln.match(t.re);if(!m)return;
      w[t.id]=(w[t.id]||0)+m.length*(nice?1:2);
      hits[t.id]=hits[t.id]||{must:0,nice:0};hits[t.id][nice?'nice':'must']++;
    });
  });
  var lt=text.toLowerCase(),lvl='m';
  var yrs=(lt.match(/(\d+)\s*\+?\s*(?:-\s*\d+\s*)?(?:years|yrs)/)||[])[1];
  if(/\b(senior|sr\.?|lead|principal|staff|architect|head of)\b/.test(lt)||(yrs&&+yrs>=5))lvl='s';
  else if(/\b(junior|jr\.?|intern|internship|fresher|entry[- ]level|graduate|trainee)\b/.test(lt)||(yrs&&+yrs<=1))lvl='j';
  var resp=lines.filter(function(l){return /^(build|develop|design|maintain|lead|own|write|work|collaborat|implement|optimi|integrat|manage|mentor|ensure|create|review|participat|troubleshoot|deploy)/i.test(l.replace(/^[-•*\d.)\s]+/,''))}).slice(0,10);
  var title=(lines[0]||'').slice(0,90);
  var ids=Object.keys(w).filter(function(k){return w[k]>0});
  ids.sort(function(a,b){return w[b]-w[a]});
  if(lvl==='s'){['sysdesign','architecture','leadership'].forEach(function(k){if(!w[k]){w[k]=1;ids.push(k)}})}
  if(!w.behavioral){w.behavioral=1;ids.push('behavioral')}
  if(!w.patterns&&(w.php||w.laravel)){w.patterns=1;ids.push('patterns')}
  return {title:title,lvl:lvl,years:yrs||null,weights:w,hits:hits,ids:ids,resp:resp,on:ids.reduce(function(o,k){o[k]=true;return o},{})};
}
function planFor(jd,perTech){
  perTech=perTech||8;
  var groups=[],used={};
  var ids=jd.ids.filter(function(k){return jd.on[k]});
  ids.forEach(function(tid){
    var cand=QS.filter(function(q){return q.t.indexOf(tid)>=0&&!used[q.id]});
    cand.forEach(function(q){
      var s=relScore(q)*2;
      q.t.forEach(function(t){if(jd.on[t]&&t!==tid)s+=Math.min(jd.weights[t]||0,4)});
      if(q.l===jd.lvl)s+=3;else if(jd.lvl==='s'&&q.l==='m')s+=1;else if(jd.lvl==='j'&&q.l==='s')s-=3;
      if(q.s==='ai'&&q.c==='JD')s+=6;
      if(S.done[q.id]&&S.rate[q.id]===3)s-=3;
      q._s=s;
    });
    cand.sort(function(a,b){return b._s-a._s});
    var pick=cand.slice(0,perTech);pick.forEach(function(q){used[q.id]=1});
    if(pick.length)groups.push({tech:tid,qs:pick});
  });
  return groups;
}
