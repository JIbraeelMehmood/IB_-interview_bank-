  <button type="button" data-tab="me"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg><span data-i18n="nav.me">Progress</span></button>
</div></nav>

<div class="player hidden" id="player" aria-label="Audio player"><div class="wrap pin">
  <button type="button" id="pPrev" aria-label="Previous"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M6 6h2v12H6zM9.5 12 18 6v12z"/></svg></button>
  <button type="button" class="pp" id="pPlay" aria-label="Play"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>
  <button type="button" id="pNext" aria-label="Next"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M16 6h2v12h-2zM6 18V6l8.5 6z"/></svg></button>
  <button type="button" class="pinfo" id="pInfo" aria-label="Show what is playing"><span class="pt" id="pTitle"></span><span class="ps" id="pSub"></span></button>
  <button type="button" class="spd" id="pSpeed" aria-label="Speed">1×</button>
  <button type="button" id="pClose" aria-label="Close player"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
</div><div class="pbar"><i id="pProg"></i></div></div>
<div class="sheet" id="sheet" role="dialog" aria-modal="true"><div class="scrim" data-close></div><div class="card"><button class="x" type="button" data-close aria-label="Close">×</button><div id="sheetBody"></div></div></div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

